class Solution {
    public int[] scoreValidator(String[] events) {

        // Variable to store the total score
        int score = 0;

        // Variable to count wickets
        int counter = 0;

        // Loop through each event in the array
        for(int i = 0; i < events.length; i++) {

            // Check if the event is a valid run (0 to 6)
            if(events[i].equals("0") || events[i].equals("1") || 
               events[i].equals("2") || events[i].equals("3") || 
               events[i].equals("4") || events[i].equals("5") || 
               events[i].equals("6")) {

                // Convert string run value to integer
                int temp = Integer.parseInt(events[i]);

                // Add runs to total score
                score = score + temp;

            } else if(events[i].equals("W")) {

                // Increment wicket counter
                counter++;

                if(counter == 10){

                    break;

                }

            } else if(events[i].equals("WD")) {

                // Wide ball adds 1 extra run
                score = score + 1;

            } else if(events[i].equals("NB")) {

                // No ball adds 1 extra run
                score = score + 1;
            }
        }

        // Maximum wickets possible are 10
        if(counter > 10) {
            counter = 10;
        }

        // Create result array
        int[] result = new int[2];

        // Store total score at index 0
        result[0] = score;

        // Store wicket count at index 1
        result[1] = counter;

        // Return final result
        return result;
    }
}